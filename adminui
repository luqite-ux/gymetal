const SidebarItem = ({ icon: Icon, label, active, count, onClick }) => (
  <div 
    onClick={onClick}
    className={`flex items-center justify-between px-4 py-3 rounded-2xl cursor-pointer transition-all duration-300 group mb-1
    ${active 
      ? 'bg-slate-900 text-white shadow-lg shadow-slate-200' 
      : 'text-slate-500 hover:bg-slate-50 hover:text-slate-900'}`}
  >
    <div className="flex items-center space-x-3">
      <Icon size={20} strokeWidth={active ? 2.5 : 2} />
      <span className="font-bold text-sm">{label}</span>
    </div>
    {count && (
      <span className={`text-[10px] px-2 py-0.5 rounded-full font-black ${active ? 'bg-white/20 text-white' : 'bg-slate-100 text-slate-400'}`}>
        {count}
